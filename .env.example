# All optional. Without GEMINI_API_KEY, MarkoDoc uses an offline heuristic
# classifier so the full pipeline still runs.

# SQLite database file (use /data/markodoc.db on Railway with a volume)
MARKODOC_DB=./markodoc.db

# Host to bind to (use 0.0.0.0 in production)
HOST=127.0.0.1

# Dashboard password — if set, a login page is shown
MARKODOC_PASSWORD=

# Default tier for newly added documents: free | commercial
MARKODOC_DEFAULT_TIER=free

# Fetch timeout in milliseconds
FETCH_TIMEOUT_MS=15000

# Web dashboard port (npm run serve)
PORT=4000

# Scheduler interval in minutes (npm run schedule, or web autopoll)
POLL_INTERVAL_MINUTES=60
# Set true to also poll from inside the web server process
WEB_AUTOPOLL=false

# Enable LLM-based classification
GEMINI_API_KEY=
# Set to a current Gemini "flash"-class model available on your account
GEMINI_MODEL=gemini-2.0-flash

# Webhook notifications: POST JSON on every detected change
NOTIFY_WEBHOOK_URL=
# Minimum severity to trigger a notification: critical | high | medium | low | info
NOTIFY_MIN_SEVERITY=high

# Email notifications via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MarkoDoc <noreply@markodoc.local>
NOTIFY_EMAIL_TO=
